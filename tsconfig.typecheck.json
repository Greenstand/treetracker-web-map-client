// The type check of the JavaScript code: npm run typecheck (all errors) and
// npm run baseline -- tsc (new errors only, as in CI).
// Do not rename this file to tsconfig.json. With a tsconfig.json, Next.js
// treats the project as TypeScript and type checks it in "next build".
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // A value without a type is "any". JSDoc can add types later.
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // The same imports as jsconfig.json: "models/utils" is src/models/utils.
    "paths": {
      "*": ["./src/*"]
    },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"],
  // The Cypress tests use other global types (cy, Chai's expect).
  "exclude": ["src/**/*.cy.js"]
}
